{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/chat/**",
              "components/core/**",
              "components/forms/**",
              "components/game/**",
              "mui/**",
              "ui_kits/goblin-pub-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Alegreya|Alegreya SC|Alegreya Sans|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Alegreya, Alegreya SC, Alegreya Sans, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AbilityScore'] > JSXAttribute > JSXIdentifier[name!=/^(?:abbr|score|modifier|compact|style|key|ref|className|style|children)$/]",
        "message": "<AbilityScore> doesn't accept that prop. Declared props: abbr, score, modifier, compact, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|icon|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|accent|moss|danger|magic)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'accent' | 'moss' | 'danger' | 'magic'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|iconRight|fullWidth|loading|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, iconRight, fullWidth, loading."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|outline|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'outline' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|lantern|organic|padding|title|action|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: tone, lantern, organic, padding, title, action."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|raised|timber|sunken)$/]",
        "message": "<Card> tone must be one of 'default' | 'raised' | 'timber' | 'sunken'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChatComposer'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|onSend|placeholder|actions|disabled|style|key|ref|className|style|children)$/]",
        "message": "<ChatComposer> doesn't accept that prop. Declared props: value, onChange, onSend, placeholder, actions, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChatMessage'] > JSXAttribute > JSXIdentifier[name!=/^(?:role|author|time|avatar|children|style|key|ref|className|style|children)$/]",
        "message": "<ChatMessage> doesn't accept that prop. Declared props: role, author, time, avatar, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChatMessage'] > JSXAttribute[name.name='role'] > Literal[value!=/^(?:dm|player|system)$/]",
        "message": "<ChatMessage> role must be one of 'dm' | 'player' | 'system'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|label|disabled|style|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: checked, onChange, label, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|children|footer|onClose|width|key|ref|className|style|children)$/]",
        "message": "<Dialog> doesn't accept that prop. Declared props: open, title, children, footer, onClose, width."
      },
      {
        "selector": "JSXOpeningElement[name.name='DiceRoll'] > JSXAttribute > JSXIdentifier[name!=/^(?:notation|total|breakdown|outcome|label|style|key|ref|className|style|children)$/]",
        "message": "<DiceRoll> doesn't accept that prop. Declared props: notation, total, breakdown, outcome, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DiceRoll'] > JSXAttribute[name.name='outcome'] > Literal[value!=/^(?:neutral|crit|fumble)$/]",
        "message": "<DiceRoll> outcome must be one of 'neutral' | 'crit' | 'fumble'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Divider'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|key|ref|className|style|children)$/]",
        "message": "<Divider> doesn't accept that prop. Declared props: label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|error|htmlFor|children|key|ref|className|style|children)$/]",
        "message": "<Field> doesn't accept that prop. Declared props: label, hint, error, htmlFor, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|size|variant|active|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, label, size, variant, active."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<IconButton> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:ghost|solid)$/]",
        "message": "<IconButton> variant must be one of 'ghost' | 'solid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|icon|invalid|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: value, onChange, icon, invalid."
      },
      {
        "selector": "JSXOpeningElement[name.name='PlayerStatCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|subtitle|portrait|hp|ac|initiative|conditions|abilities|active|compact|onClick|style|key|ref|className|style|children)$/]",
        "message": "<PlayerStatCard> doesn't accept that prop. Declared props: name, subtitle, portrait, hp, ac, initiative, conditions, abilities, active, compact, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ResourceBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|max|kind|suffix|style|key|ref|className|style|children)$/]",
        "message": "<ResourceBar> doesn't accept that prop. Declared props: label, value, max, kind, suffix, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ResourceBar'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:hp|xp|spell)$/]",
        "message": "<ResourceBar> kind must be one of 'hp' | 'xp' | 'spell'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SceneImage'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|caption|chapter|height|children|style|key|ref|className|style|children)$/]",
        "message": "<SceneImage> doesn't accept that prop. Declared props: src, caption, chapter, height, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<SelectOption> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|label|disabled|style|key|ref|className|style|children)$/]",
        "message": "<Switch> doesn't accept that prop. Declared props: checked, onChange, label, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:onRemove|selected|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: onRemove, selected."
      },
      {
        "selector": "JSXOpeningElement[name.name='Textarea'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|invalid|rows|key|ref|className|style|children)$/]",
        "message": "<Textarea> doesn't accept that prop. Declared props: value, onChange, invalid, rows."
      },
      {
        "selector": "JSXOpeningElement[name.name='TypingIndicator'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|style|key|ref|className|style|children)$/]",
        "message": "<TypingIndicator> doesn't accept that prop. Declared props: label, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
