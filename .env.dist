COMPOSE_FILE=compose.yaml

# Host-side bind address and ports for Compose's published ports
LOCAL_HOST_IP=127.0.0.1
LOCAL_HOST_WEB_PORT=8000
LOCAL_HOST_VITE_PORT=5173

# Browser-visible API URL. For a single-host reverse proxy that sends /api/*
# to app-web, use the public frontend origin here (for example,
# https://dnd.example.com). For separate frontend/API hostnames, use the
# public API origin instead (for example, https://api.dnd.example.com).
VITE_API_URL=http://localhost:8000

# Public frontend hostname accepted by the Vite server when it sits behind a
# reverse proxy. Use the bare hostname only: no scheme, port, or path. Leave
# blank for localhost/IP-only development.
VITE_ALLOWED_HOST=

# Template for the local .env file: `cp .env.dist .env` and adjust values.
# .env itself is never committed.

# Application mode: "development" enables /docs and the Compose development
# server uses uvicorn --reload; "production" disables /docs. A public reverse
# proxy hostname works in either mode.
ENVIRONMENT=development

# Verbosity of the application log, which is written to stderr — stdout must
# stay pure JSON so `app openapi export` can be redirected to a file.
# One of: CRITICAL | ERROR | WARNING | INFO | DEBUG
LOG_LEVEL=INFO

# Async SQLAlchemy URL for the application database (psycopg 3 driver).
# Used by both the app and Alembic. Host/port/credentials must match the
# "postgres" Compose service; change both places or neither.
DATABASE_URL=postgresql+psycopg://app:app@postgres:5432/application

# How long a session stays valid after sign-in, in seconds (default 14 days).
# Session tokens are opaque random values looked up in the sessions table —
# nothing is signed, so there is no secret to configure.
SESSION_TTL_SECONDS=1209600

# Browser origin allowed to send credentialed requests to the API (CORS).
# The default matches the "frontend" Compose service's published port.
FRONTEND_ORIGIN=http://localhost:5173

# OpenRouter is the only LLM gateway (chat, embeddings and images). Create a
# key at https://openrouter.ai/keys. Left empty here: without it the
# application still starts, and every model call reports the missing key
# instead of failing obscurely.
OPENROUTER_API_KEY=

# Default chat model, as an OpenRouter model identifier.
CHAT_MODEL=openai/gpt-4.1-mini

# How many times a retryable LLM failure is attempted in total, the first
# try included. 1 disables retry; the player sees nothing until the budget
# is spent.
LLM_RETRY_ATTEMPTS=3

# Base delay: attempt n waits base × 2^(n-1), jittered. A `Retry-After`
# header wins over this.
LLM_RETRY_BACKOFF_SECONDS=0.5

# Embedding model, as an OpenRouter model identifier. Its native vector size is
# 1536; no `dimensions` parameter is ever sent.
EMBEDDING_MODEL=openai/text-embedding-3-small

# Width of the vectors the embedding model returns. This must equal the
# `vector(n)` width of the embedding column: changing the model to one with a
# different size requires a migration that alters that column.
EMBEDDING_DIMENSIONS=1536

# Image model for character portraits, as an OpenRouter model identifier.
# Reached through OpenRouter's own images endpoint, not through LangChain: no
# binding exists for it. Portrait generation falls back to a deterministic
# placeholder whenever the call fails.
IMAGE_MODEL=google/gemini-3.1-flash-image

# Langfuse tracing of every model call (chat, embeddings, images). Langfuse
# runs as an external service — there is no bundled stack to start. Leave
# all three empty (the default) to run without it: the app then behaves
# byte-identically, and a Langfuse outage never fails a request either way.
#
# Keys come from the Langfuse project under Settings → API Keys (create a
# project key pair there). The base URL must be reachable from inside the
# containers, so a host-only http://localhost:3000 will not work.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://langfuse.hermann.pm
