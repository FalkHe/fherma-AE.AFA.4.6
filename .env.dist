# Template for the local .env file: `cp .env.dist .env` and adjust values.
# .env itself is never committed.

# Deployment mode: "development" enables /docs and uvicorn --reload; "production" does not.
ENVIRONMENT=development

# Verbosity of the application log, which is written to stderr — stdout must
# stay pure JSON so `app openapi export` can be redirected to a file.
# One of: CRITICAL | ERROR | WARNING | INFO | DEBUG
LOG_LEVEL=INFO

# Async SQLAlchemy URL for the application database (psycopg 3 driver).
# Used by both the app and Alembic. Host/port/credentials must match the
# "postgres" Compose service; change both places or neither.
DATABASE_URL=postgresql+psycopg://app:app@postgres:5432/application

# How long a session stays valid after sign-in, in seconds (default 14 days).
# Session tokens are opaque random values looked up in the sessions table —
# nothing is signed, so there is no secret to configure.
SESSION_TTL_SECONDS=1209600

# Browser origin allowed to send credentialed requests to the API (CORS).
# The default matches the "frontend" Compose service's published port.
FRONTEND_ORIGIN=http://localhost:5173

# OpenRouter is the only LLM gateway (chat, embeddings and images). Create a
# key at https://openrouter.ai/keys. Left empty here: without it the
# application still starts, and every model call reports the missing key
# instead of failing obscurely.
OPENROUTER_API_KEY=

# Default chat model, as an OpenRouter model identifier.
CHAT_MODEL=openai/gpt-4.1-mini

# Embedding model, as an OpenRouter model identifier. Its native vector size is
# 1536; no `dimensions` parameter is ever sent.
EMBEDDING_MODEL=openai/text-embedding-3-small

# Width of the vectors the embedding model returns. This must equal the
# `vector(n)` width of the embedding column: changing the model to one with a
# different size requires a migration that alters that column.
EMBEDDING_DIMENSIONS=1536

# Image model for character portraits, as an OpenRouter model identifier.
# Reached through OpenRouter's own images endpoint, not through LangChain: no
# binding exists for it. Portrait generation falls back to a deterministic
# placeholder whenever the call fails.
IMAGE_MODEL=google/gemini-3.1-flash-image

# Optional Langfuse tracing of chat-model calls (never embeddings — LangChain
# embeddings emit no callback events). Leave all three empty (the default) to
# run without it; the app behaves byte-identically and a Langfuse outage never
# fails a request.
#
# The bundled dev Langfuse stack lives in compose.langfuse.yaml. Enable it by
# adding that file to COMPOSE_FILE (docker compose reads this from .env), then
# `make up`:
# COMPOSE_FILE=compose.yaml:compose.langfuse.yaml
# (append `:compose.local.yaml` if you use local overrides.) That file also
# wires app-web to the bundled instance via service-level `environment:`
# overrides, which take precedence over the values below — so for the bundled
# stack, leave these empty. Set them only to trace to Langfuse Cloud (or
# another external instance) instead; the host must be reachable from inside
# the containers (e.g. https://cloud.langfuse.com — never
# http://localhost:3000, which only works from the host browser).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Secrets for the bundled dev Langfuse stack (compose.langfuse.yaml). Only
# required when that file is in COMPOSE_FILE — compose then fails loudly if
# any is empty. Generate each with `openssl rand -hex 16` (ENCRYPTION_KEY
# must be `openssl rand -hex 32`: exactly 64 hex chars). The API key pair
# must look like pk-lf-<uuid> / sk-lf-<uuid> (`python3 -c "import uuid;
# print(uuid.uuid4())"`). langfuse-web seeds org/project/user/keys from the
# LANGFUSE_INIT_* values on first boot; changing them later does NOT update
# an existing langfuse-postgres volume, and LANGFUSE_POSTGRES_PASSWORD /
# LANGFUSE_ENCRYPTION_KEY cannot be rotated against existing data at all.
LANGFUSE_POSTGRES_PASSWORD=
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_VALKEY_PASSWORD=
LANGFUSE_MINIO_ROOT_PASSWORD=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_NAME=
LANGFUSE_INIT_USER_PASSWORD=
