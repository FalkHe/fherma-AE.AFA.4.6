            "type": "integer",
            "title": "Currenthp"
          },
          "maxHp": {
            "type": "integer",
            "title": "Maxhp"
          },
          "armourClass": {
            "type": "integer",
            "title": "Armourclass"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "currentHp",
          "maxHp",
          "armourClass"
        ],
        "title": "CharacterRead",
        "description": "The character, on the wire -- `id, name, currentHp, maxHp,\narmourClass` and nothing else (I2): no state, no keys, no ownership."
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "details": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          }
