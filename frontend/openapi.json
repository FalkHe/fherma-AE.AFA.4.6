        },
        "type": "object",
        "required": [
          "id",
          "adventureId",
          "status",
          "startedAt"
        ],
        "title": "AdventureRunRead",
        "description": "One adventure run, on the wire -- `id, adventureId, status,\nstartedAt` and nothing else (I1): the adventure run's internals\n(`campaignRunId`, `completedAt`, `updatedAt`) stay internal."
      },
      "CampaignRunRead": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "campaignId": {
            "type": "string",
