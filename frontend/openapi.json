            "format": "date-time",
            "title": "Createdat"
          }
        },
        "type": "object",
        "required": [
          "id",
          "campaignId",
          "contentVersion",
          "title",
          "status",
          "createdAt"
        ],
        "title": "CampaignRunRead",
        "description": "The run row, not its state -- `id, campaignId, contentVersion,\ntitle, status, createdAt` and nothing else (I2)."
      },
      "CampaignSummaryRead": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
