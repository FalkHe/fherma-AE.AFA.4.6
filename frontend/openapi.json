    "/api/v1/playthrough/campaign/{run_id}/stream": {
      "get": {
        "tags": [
          "playthrough"
        ],
        "summary": "Stream Campaign Run",
        "description": "Says only \"there is something new\" (\u2190 D10) -- no content, no\naddress of its own beyond that, so the client always refetches the\ntranscript through `list_events`. Membership is checked here, before\nthe `StreamingResponse` is ever returned, so a foreign or unknown run\nanswers the ordinary error envelope instead of a stream that opens and\nimmediately dies (I3).\n\nSettings are read through `get_settings()` inside the handler, not at\nimport time, so a test can pin them small (I3).",
        "operationId": "stream_campaign_run_api_v1_playthrough_campaign__run_id__stream_get",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          }
        ],
        "responses": {
